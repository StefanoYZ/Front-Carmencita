# Frontend React/Vite - Carmencita Express
# Copia este archivo como .env para desarrollo local.
# En Netlify o al construir Docker, configura VITE_API_BASE_URL con la URL publica del backend.

# Local:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_API_TIMEOUT_MS=75000

# Despliegue:
# VITE_API_BASE_URL=https://tu-backend.onrender.com/api/v1
# VITE_API_TIMEOUT_MS=75000
